rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn() && userDoc().active == true;
    }
    function isAdmin() {
      return isActive() && userDoc().role == 'admin';
    }
    function isGerente() {
      return isActive() && userDoc().role == 'gerente';
    }
    function isGerenteOrAdmin() {
      return isAdmin() || isGerente();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isGerenteOrAdmin() || isActive());
      allow create: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.role in ['gerente', 'admin'] && request.resource.data.active == true) ||
        isAdmin() ||
        (isGerente() && request.resource.data.role in ['vendedor', 'gerente'])
      );
      allow update: if isGerenteOrAdmin() || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if isGerenteOrAdmin();
    }

    match /icp/{docId} {
      allow read: if isActive();
      allow write: if isGerenteOrAdmin();
    }

    match /empresas/{id} {
      allow read: if isActive();
      allow write: if isActive();
    }

    match /contactos/{id} {
      allow read: if isActive();
      allow write: if isActive();
    }

    match /oportunidades/{id} {
      allow read: if isActive() && (isGerenteOrAdmin() || resource.data.vendedorId == request.auth.uid);
      allow create: if isActive() && (isGerenteOrAdmin() || request.resource.data.vendedorId == request.auth.uid);
      allow update: if isActive() && (isGerenteOrAdmin() || resource.data.vendedorId == request.auth.uid);
      allow delete: if isGerenteOrAdmin() || (isActive() && resource.data.vendedorId == request.auth.uid);
    }

    match /archivos/{id} {
      allow read: if isActive();
      allow create: if isActive();
      allow update, delete: if isActive() && (isGerenteOrAdmin() || resource.data.uploadedBy == request.auth.uid);
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
